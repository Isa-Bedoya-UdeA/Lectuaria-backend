# ============================================
# Database Configuration (Supabase - Transaction Pooler)
# ============================================
# URL del pooler de Supabase (no usar la URL directa del supabase dashboard)
DB_URL=jdbc:postgresql://aws-XX-XXXX-X.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# Usuario del pooler de Supabase (formato: postgres.xxxxxxxxxxxxxxxxxxxx)
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
# Contraseña del pooler de Supabase
DB_PASSWORD=tu_contraseña_segura

# ============================================
# JWT Configuration
# ============================================
# Clave secreta para firmar tokens JWT (MINIMO 256 bits para HS256)
# IMPORTANTE: Cambiar en producción por una clave única y aleatoria
# Generador online: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx
JWT_SECRET=tu-clave-jwt-super-segura-de-al-menos-256-bits-aqui

# ============================================
# Spring Environment
# ============================================
# Perfil activo: dev, test, o prod
SPRING_PROFILES_ACTIVE=dev

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# Email Configuration (Gmail SMTP)
# ============================================
# Email desde donde se envían los correos
EMAIL_USERNAME=tu-correo@gmail.com
# Contraseña de aplicación de Gmail (NO usar tu contraseña normal)
# Para crear: Cuenta Google > Seguridad > Contraseñas de aplicaciones
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================
# Supabase Storage (S3-compatible - para portadas de libros)
# ============================================
# Clave de acceso de Supabase Storage
AWS_ACCESS_KEY_ID=tu-access-key-id
# Clave secreta de Supabase Storage
AWS_SECRET_ACCESS_KEY=tu-secret-access-key
# Región de Supabase (normalmente us-east-1)
AWS_REGION=us-east-1
# Nombre del bucket de Storage
AWS_S3_BUCKET=book-covers
# Endpoint de Supabase Storage (formato S3-compatible)
AWS_S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.storage.supabase.co/storage/v1/s3

# ============================================
# Instrucciones de Configuración
# ============================================
# 1. Copia este archivo a .env (git lo ignorará gracias a .gitignore)
# 2. Completa todos los valores según tu entorno de Supabase
# 3. Para desarrollo local: usa los valores del pooler de Supabase
# 4. Para producción: genera claves seguras y rota las credenciales
# 5. El archivo .env se carga automáticamente por spring-dotenv
# 6. Para Gmail: usa UNA Contraseña de aplicación, no tu contraseña real
# 7. Nunca subas el archivo .env al repositorio