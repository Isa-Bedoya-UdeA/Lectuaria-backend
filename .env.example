# ============================================
# Database Configuration (Supabase)
# ============================================
# En desarrollo y producción se utiliza Supabase.
DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USER=postgres.id
DB_PASSWORD=tu_contraseña_segura

# ============================================
# JWT Configuration
# ============================================
# Clave secreta para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN)
# Debe ser una cadena larga y aleatoria
JWT_SECRET=lectuaria-super-secret-key-change-this

# ============================================
# Spring Environment
# ============================================
# Perfil activo: dev, test, o prod
# Por defecto está configurado a 'dev'
SPRING_PROFILES_ACTIVE=dev

FRONTEND_URL=tu-url

# ============================================
# EMAIL CONFIG (Gmail SMTP)
# ============================================
# Fill in your Gmail credentials (use App Password, not your regular password)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ============================================
# Instrucciones de Configuración
# ============================================
# 1. Copia este archivo a .env (git lo ignorará)
# 2. Actualiza los valores según tu entorno
# 3. Para desarrollo local: deja los valores por defecto
# 4. Para producción: cambia DB_PASSWORD y JWT_SECRET por valores seguros
# 5. El archivo .env será leído automáticamente por spring-dotenv
# 6. Para Gmail: usa una App Password en EMAIL_PASSWORD (no tu contraseña real)
