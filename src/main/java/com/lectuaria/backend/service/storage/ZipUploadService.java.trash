package com.lectuaria.backend.service.storage;

import com.lectuaria.backend.model.auth.User;
import com.lectuaria.backend.model.book.Book;
import com.lectuaria.backend.model.book.ZipUpload;
import com.lectuaria.backend.model.book.ZipUploadResult;
import com.lectuaria.backend.repository.auth.UserRepository;
import com.lectuaria.backend.repository.book.BookRepository;
import com.lectuaria.backend.repository.book.ZipUploadRepository;
import com.lectuaria.backend.repository.book.ZipUploadResultRepository;
import com.lectuaria.backend.repository.library.LibraryBookRepository;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import jakarta.transaction.Transactional;
import java.io.IOException;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;
import java.util.Set;
import java.util.zip.ZipEntry;
import java.util.zip.ZipInputStream;

@Service
public class ZipUploadService {

    private static final Logger logger = LoggerFactory.getLogger(ZipUploadService.class);
    private static final Set<String> IMAGE_EXTENSIONS = Set.of("jpg", "jpeg", "png", "webp");

    private final S3StorageService s3StorageService;
    private final UserRepository userRepository;
    private final BookRepository bookRepository;
    private final ZipUploadRepository zipUploadRepository;
    private final ZipUploadResultRepository zipUploadResultRepository;
    private final LibraryBookRepository libraryBookRepository;

    public ZipUploadService(
            S3StorageService s3StorageService,
            UserRepository userRepository,
            BookRepository bookRepository,
            ZipUploadRepository zipUploadRepository,
            ZipUploadResultRepository zipUploadResultRepository,
            LibraryBookRepository libraryBookRepository) {
        this.s3StorageService = s3StorageService;
        this.userRepository = userRepository;
        this.bookRepository = bookRepository;
        this.zipUploadRepository = zipUploadRepository;
        this.zipUploadResultRepository = zipUploadResultRepository;
        this.libraryBookRepository = libraryBookRepository;
    }

    /**
     * Process a ZIP file: extract images, match by ISBN in filename, upload to S3, update book covers.
     * Returns a ZipUploadResultSummary with overall stats.
     */
    @Transactional
    public ZipUploadResultSummary processZip(MultipartFile file, Long userId) throws IOException {
        User user = userRepository.findById(userId)
                .orElseThrow(() -> new IllegalArgumentException("Usuario no encontrado con ID: " + userId));

        // 1. Create upload record
        ZipUpload zipUpload = new ZipUpload();
        zipUpload.setUser(user);
        zipUpload.setStatus("PENDING");
        zipUpload.setUploadDate(LocalDateTime.now());
        zipUpload = zipUploadRepository.save(zipUpload);

        int total = 0, success = 0, notFound = 0, failed = 0;
        List<String> errors = new ArrayList<>();

        try (ZipInputStream zis = new ZipInputStream(file.getInputStream())) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                if (entry.isDirectory() || !isImageFile(entry.getName())) {
                    zis.closeEntry();
                    continue;
                }

                total++;
                String fileName = entry.getName();
                String rawIsbn = s3StorageService.extractIsbnFromFileName(fileName);

                if (rawIsbn == null || rawIsbn.length() < 10) {
                    ZipUploadResult result = new ZipUploadResult();
                    result.setZipUpload(zipUpload);
                    result.setIsbn(0L);
                    result.setFileName(fileName);
                    result.setStatus("FAILED");
                    result.setMessage("Nombre de archivo no contiene un ISBN válido");
                    zipUploadResultRepository.save(result);
                    failed++;
                    errors.add("[" + fileName + "] ISBN no válido en nombre de archivo");
                    zis.closeEntry();
                    continue;
                }

                long isbn = Long.parseLong(rawIsbn);
                Optional<Book> bookOpt = bookRepository.findByIsbn(isbn);

                if (bookOpt.isEmpty()) {
                    ZipUploadResult result = new ZipUploadResult();
                    result.setZipUpload(zipUpload);
                    result.setIsbn(isbn);
                    result.setFileName(fileName);
                    result.setStatus("NOT_FOUND");
                    result.setMessage("No se encontró libro con ISBN: " + isbn);
                    zipUploadResultRepository.save(result);
                    notFound++;
                    errors.add("[" + fileName + "] Libro no encontrado con ISBN: " + isbn);
                    zis.closeEntry();
                    continue;
                }

                try {
                    byte[] imageBytes = zis.readAllBytes();
                    String coverUrl = s3StorageService.uploadCoverBytes(imageBytes, isbn, getContentType(fileName));

                    // Delete old cover if exists
                    Book book = bookOpt.get();
                    if (book.getCoverUrl() != null) {
                        s3StorageService.deleteCover(book.getCoverUrl());
                    }

                    book.setCoverUrl(coverUrl);
                    bookRepository.save(book);

                    ZipUploadResult result = new ZipUploadResult();
                    result.setZipUpload(zipUpload);
                    result.setIsbn(isbn);
                    result.setFileName(fileName);
                    result.setStatus("ASSOCIATED");
                    result.setMessage("Portada actualizada exitosamente");
                    zipUploadResultRepository.save(result);

                    success++;
                    logger.info("Updated cover for book ISBN {}: {}", isbn, coverUrl);

                } catch (Exception e) {
                    ZipUploadResult result = new ZipUploadResult();
                    result.setZipUpload(zipUpload);
                    result.setIsbn(isbn);
                    result.setFileName(fileName);
                    result.setStatus("FAILED");
                    result.setMessage(e.getMessage());
                    zipUploadResultRepository.save(result);
                    failed++;
                    errors.add("[" + fileName + "] " + e.getMessage());
                    logger.error("Failed to process image {}: {}", fileName, e.getMessage());
                }

                zis.closeEntry();
            }
        }

        // Update upload record
        zipUpload.setStatus("PROCESSED");
        zipUpload.setTotalImages(total);
        zipUpload.setAssociatedImages(success);
        zipUpload.setNotFoundImages(notFound + failed);
        zipUploadRepository.save(zipUpload);

        return new ZipUploadResultSummary(total, success, notFound + failed, errors);
    }

    private boolean isImageFile(String name) {
        if (name == null) return false;
        String lower = name.toLowerCase();
        for (String ext : IMAGE_EXTENSIONS) {
            if (lower.endsWith("." + ext)) return true;
        }
        return false;
    }

    private String getContentType(String fileName) {
        if (fileName == null) return "image/jpeg";
        String lower = fileName.toLowerCase();
        if (lower.endsWith(".png")) return "image/png";
        if (lower.endsWith(".webp")) return "image/webp";
        return "image/jpeg";
    }

    // ─── Inner DTO ───────────────────────────────────────────────────────────

    public static class ZipUploadResultSummary {
        private final int totalRecords;
        private final int successfulRecords;
        private final int failedRecords;
        private final List<String> errors;

        public ZipUploadResultSummary(int total, int success, int failed, List<String> errors) {
            this.totalRecords = total;
            this.successfulRecords = success;
            this.failedRecords = failed;
            this.errors = errors;
        }

        public int getTotalRecords() { return totalRecords; }
        public int getSuccessfulRecords() { return successfulRecords; }
        public int getFailedRecords() { return failedRecords; }
        public List<String> getErrors() { return errors; }
    }
}